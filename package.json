{
  "name": "quan-ly-dai-ly",
  "version": "1.0.0",
  "description": "Hệ thống quản lý các đại lý - Lab 08: Coding Standards, Best Practices & Code Review",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint ."
  },
  "keywords": [
    "express",
    "jest",
    "supertest",
    "code-review"
  ],
  "author": "Nhóm 02 - N2.2",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "app.js",
      "config/**/*.js",
      "errors/**/*.js",
      "middlewares/**/*.js",
      "repositories/*.js",
      "routes/**/*.js",
      "services/**/*.js",
      "utils/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 80,
        "functions": 80,
        "lines": 80
      }
    }
  }
}
